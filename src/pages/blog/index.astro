---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GradientOrbs from '../../components/GradientOrbs.astro';
import BlogCard from '../../components/BlogCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = "Blog | fullai.dev";
const pageDescription = "Insights on AI strategy, engineering, and software development from the fullai.dev team.";
---

<BaseLayout title={pageTitle} description={pageDescription} currentPage="blog">
    <section class="blog-header">
        <GradientOrbs variant="section" />
        <div class="container">
            <h1 class="blog-title" data-en="Blog" data-es="Blog">Blog</h1>
            <p class="blog-subtitle" data-en="Insights on AI, engineering, and building the future" data-es="Ideas sobre IA, ingeniería y construyendo el futuro">Insights on AI, engineering, and building the future</p>
        </div>
    </section>

    <section class="blog-grid-section">
        <div class="container">
            {sortedPosts.length === 0 ? (
                <div class="no-posts">
                    <p data-en="No posts yet. Check back soon!" data-es="Aún no hay publicaciones. ¡Vuelve pronto!">No posts yet. Check back soon!</p>
                </div>
            ) : (
                <div class="blog-grid">
                    {sortedPosts.map((post) => (
                        <BlogCard
                            title={post.data.title}
                            description={post.data.description}
                            slug={post.slug}
                            pubDate={post.data.pubDate}
                            lang={post.data.lang}
                            tags={post.data.tags}
                        />
                    ))}
                </div>
            )}
        </div>
    </section>
</BaseLayout>

<style>
    .blog-header {
        position: relative;
        padding: 10rem 0 4rem;
        text-align: center;
        overflow: hidden;
    }

    .blog-title {
        font-family: var(--font-display);
        font-size: clamp(3rem, 8vw, 5rem);
        font-weight: 800;
        background: linear-gradient(135deg, var(--color-text), var(--color-primary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
    }

    .blog-subtitle {
        color: var(--color-text-dim);
        font-size: 1.1rem;
        max-width: 500px;
        margin: 0 auto;
    }

    .blog-grid-section {
        padding: 4rem 0 6rem;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
    }

    .no-posts {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--color-text-dim);
    }

    @media (max-width: 768px) {
        .blog-header {
            padding: 8rem 0 3rem;
        }

        .blog-title {
            font-size: 2.5rem;
        }

        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    // Filter blog cards by language when language changes
    const blogCards = document.querySelectorAll('.blog-card');

    function filterBlogCards(lang: string) {
        blogCards.forEach(card => {
            const cardLang = card.getAttribute('data-lang');
            if (cardLang === lang) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        });
    }

    // Listen for language changes (from BaseLayout's language switcher)
    const langSwitch = document.getElementById('langSwitch');
    let isEnglish = localStorage.getItem('lang') !== 'es';

    // Initial filter
    filterBlogCards(isEnglish ? 'en' : 'es');

    langSwitch?.addEventListener('click', () => {
        isEnglish = !isEnglish;
        filterBlogCards(isEnglish ? 'en' : 'es');
    });
</script>

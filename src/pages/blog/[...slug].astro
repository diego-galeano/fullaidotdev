---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = "https://fullai.dev";

function formatDate(date: Date, lang: string = 'en'): string {
    return date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}
---

<!DOCTYPE html>
<html lang={post.data.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{post.data.title} | fullai.dev</title>
    <meta name="description" content={post.data.description}>
    <meta name="author" content={post.data.author}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={`${siteUrl}/blog/${post.slug}`}>

    <meta name="theme-color" content="#0a0e17">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <meta property="og:type" content="article">
    <meta property="og:url" content={`${siteUrl}/blog/${post.slug}`}>
    <meta property="og:title" content={post.data.title}>
    <meta property="og:description" content={post.data.description}>
    <meta property="og:image" content={post.data.image || `${siteUrl}/og-image.png`}>
    <meta property="article:published_time" content={post.data.pubDate.toISOString()}>
    <meta property="article:author" content={post.data.author}>
    {post.data.tags.map(tag => (
        <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={post.data.title}>
    <meta name="twitter:description" content={post.data.description}>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Navigation -->
    <nav class="nav" role="navigation" aria-label="Main navigation">
        <div class="nav-container">
            <a href="/" class="logo" aria-label="fullai.dev Home">
                <div class="logo-group">
                    <img src="/logo.png" alt="fullai.dev" class="logo-img">
                    <span class="logo-text">fullai<span class="dot">.</span>dev</span>
                </div>
            </a>
            <div class="nav-links">
                <a href="/#services">Services</a>
                <a href="/#approach">Approach</a>
                <a href="/blog" class="active">Blog</a>
                <a href="/#contact" class="nav-cta">Let's Talk</a>
            </div>
        </div>
    </nav>

    <main id="main-content">
        <article class="blog-post">
            <div class="post-header">
                <div class="post-header-bg">
                    <div class="gradient-orb orb-1"></div>
                    <div class="gradient-orb orb-2"></div>
                </div>
                <div class="container">
                    <a href="/blog" class="back-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        <span>{post.data.lang === 'es' ? 'Volver al Blog' : 'Back to Blog'}</span>
                    </a>
                    <div class="post-meta">
                        <span class="post-lang-badge">{post.data.lang.toUpperCase()}</span>
                        <time datetime={post.data.pubDate.toISOString()}>
                            {formatDate(post.data.pubDate, post.data.lang)}
                        </time>
                        <span class="meta-separator">•</span>
                        <span>{post.data.author}</span>
                    </div>
                    <h1 class="post-title">{post.data.title}</h1>
                    <p class="post-description">{post.data.description}</p>
                    <div class="post-tags">
                        {post.data.tags.map(tag => (
                            <span class="post-tag">{tag}</span>
                        ))}
                    </div>
                </div>
            </div>

            <div class="post-content">
                <div class="container prose">
                    <Content />
                </div>
            </div>
        </article>

        <!-- Back to Blog CTA -->
        <section class="post-footer">
            <div class="container">
                <a href="/blog" class="btn-back">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    <span>{post.data.lang === 'es' ? 'Ver todas las publicaciones' : 'View all posts'}</span>
                </a>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <a href="/" class="footer-logo">
                    <img src="/logo.png" alt="fullai.dev" class="footer-logo-img">
                    <span>fullai<span class="dot">.</span>dev</span>
                </a>
                <p class="footer-tagline">Your Digital Backbone</p>
            </div>
            <div class="footer-bottom">
                <p>&copy; {new Date().getFullYear()} fullai.dev. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <style>
        :root {
            --color-bg: #0a0e17;
            --color-surface: #141821;
            --color-surface-elevated: #1a1f2e;
            --color-primary: #00ffa3;
            --color-primary-dim: #00cc82;
            --color-accent: #00d4ff;
            --color-text: #e8edf4;
            --color-text-dim: #98a2b3;
            --color-border: #2a3142;
            --font-display: 'Syne', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-mono);
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.6;
            min-height: 100vh;
        }

        .skip-link {
            position: absolute;
            top: -100%;
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-primary);
            color: var(--color-bg);
            padding: 0.75rem 1.5rem;
            border-radius: 0 0 8px 8px;
            font-weight: 600;
            z-index: 10000;
            transition: top 0.3s var(--ease-smooth);
            text-decoration: none;
        }

        .skip-link:focus {
            top: 0;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Navigation */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(10, 14, 23, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--color-border);
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .logo-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .logo-text {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-text);
        }

        .dot {
            color: var(--color-primary);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--color-text-dim);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s var(--ease-smooth);
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--color-primary);
        }

        .nav-cta {
            background: var(--color-primary) !important;
            color: var(--color-bg) !important;
            padding: 0.5rem 1.5rem !important;
            border-radius: 6px;
            font-weight: 500;
        }

        /* Post Header */
        .post-header {
            position: relative;
            padding: 10rem 0 4rem;
            overflow: hidden;
        }

        .post-header-bg {
            position: absolute;
            inset: 0;
            z-index: -1;
        }

        .gradient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
        }

        .orb-1 {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--color-primary), transparent);
            top: -200px;
            left: -200px;
        }

        .orb-2 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--color-accent), transparent);
            bottom: -100px;
            right: -200px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--color-text-dim);
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 2rem;
            transition: color 0.3s var(--ease-smooth);
        }

        .back-link:hover {
            color: var(--color-primary);
        }

        .post-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .post-lang-badge {
            background: var(--color-surface-elevated);
            color: var(--color-accent);
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .post-meta time,
        .post-meta span {
            color: var(--color-text-dim);
            font-size: 0.9rem;
        }

        .meta-separator {
            opacity: 0.5;
        }

        .post-title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--color-text), var(--color-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .post-description {
            color: var(--color-text-dim);
            font-size: 1.15rem;
            line-height: 1.7;
            margin-bottom: 2rem;
        }

        .post-tags {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .post-tag {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            color: var(--color-text-dim);
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        /* Post Content */
        .post-content {
            padding: 4rem 0;
        }

        .prose {
            color: var(--color-text);
            font-size: 1.05rem;
            line-height: 1.8;
        }

        .prose :global(h2) {
            font-family: var(--font-display);
            font-size: 1.75rem;
            font-weight: 700;
            margin: 3rem 0 1.5rem;
            color: var(--color-text);
        }

        .prose :global(h3) {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 600;
            margin: 2.5rem 0 1rem;
            color: var(--color-text);
        }

        .prose :global(p) {
            margin-bottom: 1.5rem;
        }

        .prose :global(a) {
            color: var(--color-primary);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .prose :global(a:hover) {
            color: var(--color-accent);
        }

        .prose :global(strong) {
            color: var(--color-text);
            font-weight: 600;
        }

        .prose :global(ul),
        .prose :global(ol) {
            margin: 1.5rem 0;
            padding-left: 1.5rem;
        }

        .prose :global(li) {
            margin-bottom: 0.75rem;
        }

        .prose :global(blockquote) {
            border-left: 3px solid var(--color-primary);
            padding-left: 1.5rem;
            margin: 2rem 0;
            color: var(--color-text-dim);
            font-style: italic;
        }

        .prose :global(code) {
            background: var(--color-surface);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.9em;
            color: var(--color-primary);
        }

        .prose :global(pre) {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 1.5rem;
            overflow-x: auto;
            margin: 2rem 0;
        }

        .prose :global(pre code) {
            background: none;
            padding: 0;
            font-size: 0.9rem;
            color: var(--color-text);
        }

        .prose :global(img) {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            margin: 2rem 0;
        }

        .prose :global(hr) {
            border: none;
            border-top: 1px solid var(--color-border);
            margin: 3rem 0;
        }

        /* Post Footer */
        .post-footer {
            padding: 3rem 0 5rem;
            text-align: center;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            color: var(--color-text);
            padding: 1rem 2rem;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s var(--ease-smooth);
        }

        .btn-back:hover {
            border-color: var(--color-primary);
            color: var(--color-primary);
            transform: translateX(-4px);
        }

        /* Footer */
        .footer {
            background: var(--color-surface);
            border-top: 1px solid var(--color-border);
            padding: 3rem 0 2rem;
        }

        .footer-content {
            text-align: center;
            margin-bottom: 2rem;
        }

        .footer-logo {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: var(--color-text);
            font-family: var(--font-display);
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .footer-logo-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
        }

        .footer-tagline {
            color: var(--color-text-dim);
            font-size: 0.9rem;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid var(--color-border);
            color: var(--color-text-dim);
            font-size: 0.85rem;
        }

        /* Mobile */
        @media (max-width: 768px) {
            .nav-links a:not(.nav-cta) {
                display: none;
            }

            .post-header {
                padding: 8rem 0 3rem;
            }

            .container {
                padding: 0 1.25rem;
            }

            .post-title {
                font-size: 1.75rem;
            }

            .prose {
                font-size: 1rem;
            }
        }

        :focus-visible {
            outline: 2px solid var(--color-accent);
            outline-offset: 3px;
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</body>
</html>

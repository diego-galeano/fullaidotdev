---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GradientOrbs from '../../components/GradientOrbs.astro';
import { calculateReadingTime, formatReadingTime, formatDate } from '../../utils/blog';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Calculate reading time
const readingTime = calculateReadingTime(post.body);

// Get translation if exists
let translationPost = null;
if (post.data.translationSlug) {
    const allPosts = await getCollection('blog');
    translationPost = allPosts.find(p => p.slug === post.data.translationSlug);
}

// Generate share URLs
const siteUrl = 'https://fullai.dev';
const postUrl = `${siteUrl}/blog/${post.slug}`;
const encodedUrl = encodeURIComponent(postUrl);
const encodedTitle = encodeURIComponent(post.data.title);

const shareLinks = {
    twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
};
---

<BaseLayout
    title={`${post.data.title} | fullai.dev`}
    description={post.data.description}
    currentPage="blog"
    ogImage={post.data.image || '/og-image.png'}
    ogType="article"
    articleMeta={{
        publishedTime: post.data.pubDate.toISOString(),
        author: post.data.author,
        tags: post.data.tags
    }}
    lang={post.data.lang}
>
    <article class="blog-post">
        <div class="post-header">
            <GradientOrbs variant="section" />
            <div class="container">
                <div class="header-nav">
                    <a href="/blog" class="back-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                        <span>{post.data.lang === 'es' ? 'Volver al Blog' : 'Back to Blog'}</span>
                    </a>

                    {translationPost && (
                        <a href={`/blog/${translationPost.slug}`} class="translation-link">
                            <span class="translation-flag">
                                {post.data.lang === 'es' ? '🇺🇸' : '🇦🇷'}
                            </span>
                            <span>
                                {post.data.lang === 'es' ? 'Read in English' : 'Leer en Español'}
                            </span>
                        </a>
                    )}
                </div>

                <div class="post-meta">
                    <span class="post-lang-badge">{post.data.lang.toUpperCase()}</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate, post.data.lang)}
                    </time>
                    <span class="meta-separator">•</span>
                    <span>{formatReadingTime(readingTime, post.data.lang)}</span>
                    <span class="meta-separator">•</span>
                    <span>{post.data.author}</span>
                </div>
                <h1 class="post-title">{post.data.title}</h1>
                <p class="post-description">{post.data.description}</p>
                <div class="post-tags">
                    {post.data.tags.map(tag => (
                        <span class="post-tag">{tag}</span>
                    ))}
                </div>
            </div>
        </div>

        <div class="post-content">
            <div class="container prose">
                <Content />
            </div>
        </div>
    </article>

    <section class="post-footer">
        <div class="container">
            <div class="share-section">
                <span class="share-label">{post.data.lang === 'es' ? 'Compartir' : 'Share'}</span>
                <div class="share-buttons">
                    <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on X/Twitter">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                    </a>
                    <a href={shareLinks.linkedin} target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                    </a>
                    <button class="share-btn copy-link-btn" data-url={postUrl} title={post.data.lang === 'es' ? 'Copiar enlace' : 'Copy link'}>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                        </svg>
                    </button>
                </div>
            </div>

            <a href="/blog" class="btn-back">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                <span>{post.data.lang === 'es' ? 'Ver todas las publicaciones' : 'View all posts'}</span>
            </a>
        </div>
    </section>
</BaseLayout>

<script>
    // Copy link functionality
    const copyBtn = document.querySelector('.copy-link-btn');
    copyBtn?.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url');
        if (!url) return;

        try {
            await navigator.clipboard.writeText(url);
            copyBtn.classList.add('copied');
            setTimeout(() => copyBtn.classList.remove('copied'), 2000);
        } catch (err) {
            console.error('Failed to copy:', err);
        }
    });
</script>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header Navigation */
    .header-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    /* Post Header */
    .post-header {
        position: relative;
        padding: 10rem 0 4rem;
        overflow: hidden;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text-dim);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s var(--ease-smooth);
    }

    .back-link:hover {
        color: var(--color-primary);
    }

    .translation-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        transition: all 0.3s var(--ease-smooth);
    }

    .translation-link:hover {
        border-color: var(--color-accent);
        background: var(--color-surface-elevated);
    }

    .translation-flag {
        font-size: 1.1rem;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .post-lang-badge {
        background: var(--color-surface-elevated);
        color: var(--color-accent);
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
    }

    .post-meta time,
    .post-meta span {
        color: var(--color-text-dim);
        font-size: 0.9rem;
    }

    .meta-separator {
        opacity: 0.5;
    }

    .post-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, var(--color-text), var(--color-primary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .post-description {
        color: var(--color-text-dim);
        font-size: 1.15rem;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .post-tags {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .post-tag {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        color: var(--color-text-dim);
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
    }

    /* Post Content */
    .post-content {
        padding: 4rem 0;
    }

    .prose {
        color: var(--color-text);
        font-size: 1.05rem;
        line-height: 1.8;
    }

    .prose :global(h2) {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 700;
        margin: 3rem 0 1.5rem;
        color: var(--color-text);
    }

    .prose :global(h3) {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        margin: 2.5rem 0 1rem;
        color: var(--color-text);
    }

    .prose :global(p) {
        margin-bottom: 1.5rem;
    }

    .prose :global(a) {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .prose :global(a:hover) {
        color: var(--color-accent);
    }

    .prose :global(strong) {
        color: var(--color-text);
        font-weight: 600;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
    }

    .prose :global(li) {
        margin-bottom: 0.75rem;
    }

    .prose :global(blockquote) {
        border-left: 3px solid var(--color-primary);
        padding-left: 1.5rem;
        margin: 2rem 0;
        color: var(--color-text-dim);
        font-style: italic;
    }

    .prose :global(code) {
        background: var(--color-surface);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9em;
        color: var(--color-primary);
    }

    .prose :global(pre) {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
        margin: 2rem 0;
    }

    .prose :global(pre code) {
        background: none;
        padding: 0;
        font-size: 0.9rem;
        color: var(--color-text);
    }

    .prose :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        margin: 2rem 0;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 3rem 0;
    }

    /* Post Footer */
    .post-footer {
        padding: 3rem 0 5rem;
        text-align: center;
    }

    .share-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .share-label {
        color: var(--color-text-dim);
        font-size: 0.9rem;
    }

    .share-buttons {
        display: flex;
        gap: 0.75rem;
    }

    .share-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        color: var(--color-text-dim);
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s var(--ease-smooth);
    }

    .share-btn:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateY(-2px);
    }

    .share-btn.copied {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: var(--color-bg);
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        color: var(--color-text);
        padding: 1rem 2rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s var(--ease-smooth);
    }

    .btn-back:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateX(-4px);
    }

    @media (max-width: 768px) {
        .post-header {
            padding: 8rem 0 3rem;
        }

        .container {
            padding: 0 1.25rem;
        }

        .header-nav {
            flex-direction: column;
            align-items: flex-start;
        }

        .post-title {
            font-size: 1.75rem;
        }

        .prose {
            font-size: 1rem;
        }
    }
</style>

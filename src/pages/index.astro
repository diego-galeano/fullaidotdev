    </style>

    <script>
        // Language switching functionality
        const langSwitch = document.getElementById('langSwitch');
        const currentFlag = document.getElementById('currentFlag');
        const currentLang = document.getElementById('currentLang');

        // Language configurations
        const languages = {
            en: { flag: '🇺🇸', code: 'EN', htmlLang: 'en' },
            es: { flag: '🇦🇷', code: 'ES', htmlLang: 'es' }
        };

        // Detect browser language
        function detectBrowserLanguage(): 'en' | 'es' {
            const browserLang = navigator.language;
            // Check if browser language starts with 'es' (Spanish)
            if (browserLang && browserLang.startsWith('es')) {
                return 'es';
            }
            return 'en';
        }

        // Get stored language, or detect from browser on first visit
        const storedLang = localStorage.getItem('lang');
        let currentLanguage: 'en' | 'es' = (storedLang === 'en' || storedLang === 'es') ? storedLang : detectBrowserLanguage();

        // Apply language on page load
        function applyLanguage(lang: 'en' | 'es') {
            currentLanguage = lang;
            localStorage.setItem('lang', lang);

            // Update button display
            if (currentFlag) currentFlag.textContent = languages[lang].flag;
            if (currentLang) currentLang.textContent = languages[lang].code;

            // Update HTML lang attribute
            document.documentElement.lang = languages[lang].htmlLang;

            // Update all translatable elements
            const elements = document.querySelectorAll('[data-en][data-es]');
            elements.forEach(el => {
                const text = el.getAttribute(`data-${lang}`);
                if (text) {
                    el.textContent = text;
                }
            });
        }

        // Toggle language function
        function toggleLanguage() {
            const newLang = currentLanguage === 'en' ? 'es' : 'en';

            // Add transition class
            document.body.classList.add('lang-switching');

            // Wait for fade out, then switch language
            setTimeout(() => {
                applyLanguage(newLang);

                // Remove transition class to fade back in
                setTimeout(() => {
                    document.body.classList.remove('lang-switching');
                }, 50);
            }, 300);
        }

        // Language switch click
        langSwitch?.addEventListener('click', toggleLanguage);

        // Apply stored language on page load
        applyLanguage(currentLanguage);

        // Copy email functionality
        const copyEmailBtn = document.getElementById('copyEmailBtn') as HTMLElement | null;
        if (copyEmailBtn) {
            copyEmailBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const email = copyEmailBtn.dataset.email;
                const copyIcon = copyEmailBtn.querySelector('.copy-icon') as HTMLElement | null;
                const checkIcon = copyEmailBtn.querySelector('.check-icon') as HTMLElement | null;

                if (!email || !copyIcon || !checkIcon) return;

                try {
                    await navigator.clipboard.writeText(email);

                    // Show success state
                    copyIcon.style.display = 'none';
                    checkIcon.style.display = 'block';
                    copyEmailBtn.classList.add('copied');

                    // Reset after 2 seconds
                    setTimeout(() => {
                        copyIcon.style.display = 'block';
                        checkIcon.style.display = 'none';
                        copyEmailBtn.classList.remove('copied');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy email:', err);
                }
            });
        }
    </script>

---
// Mobile Bottom Navigation - visible only on small screens
---

<nav class="bottom-nav" role="navigation" aria-label="Mobile navigation">
    <a href="/" class="bottom-nav-item" aria-label="Home">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-en="Home" data-es="Inicio">Home</span>
    </a>
    <a href="/#services" class="bottom-nav-item" aria-label="Services">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
            <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
            <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
            <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span data-en="Services" data-es="Servicios">Services</span>
    </a>
    <a href="/#approach" class="bottom-nav-item" aria-label="Approach">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-en="Approach" data-es="Enfoque">Approach</span>
    </a>
    <a href="/blog" class="bottom-nav-item" aria-label="Blog">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6.5 2H20V22H6.5A2.5 2.5 0 0 1 4 19.5V4.5A2.5 2.5 0 0 1 6.5 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-en="Blog" data-es="Blog">Blog</span>
    </a>
    <a href="/#contact" class="bottom-nav-item" aria-label="Contact">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M22 16.92V19.92C22 20.48 21.56 20.96 21 21C14.56 21.5 8.5 18.5 4.64 13.36C1.5 9.5 0.5 6.44 1 3C1.04 2.44 1.52 2 2.08 2H5.08C5.58 2 6 2.36 6.08 2.85C6.22 3.85 6.48 4.81 6.85 5.74C7 6.08 6.92 6.48 6.65 6.74L5.35 8.04C6.62 10.38 8.61 12.38 10.96 13.65L12.26 12.35C12.52 12.08 12.92 12 13.26 12.15C14.19 12.52 15.16 12.78 16.15 12.92C16.65 13 17 13.42 17 13.92V16.92C17 17.48 16.52 17.96 15.96 18C15.64 18.02 15.32 18.02 15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span data-en="Contact" data-es="Contacto">Contact</span>
    </a>
</nav>

<style>
    .bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(10, 14, 23, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid var(--color-border);
        padding: 0.5rem 1rem;
        padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));
        justify-content: space-around;
        align-items: center;
        min-height: 60px;
    }

    .bottom-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.5rem 1rem;
        color: var(--color-text-dim);
        text-decoration: none;
        font-size: 0.7rem;
        font-weight: 500;
        transition: all 0.3s var(--ease-smooth);
        border-radius: 10px;
        background: transparent;
        border: none;
        cursor: pointer;
        font-family: var(--font-mono);
    }

    .bottom-nav-item svg {
        transition: transform 0.3s var(--ease-smooth);
    }

    .bottom-nav-item:hover,
    .bottom-nav-item:active {
        color: var(--color-primary);
    }

    .bottom-nav-item:active svg {
        transform: scale(0.9);
    }

    @media (max-width: 640px) {
        .bottom-nav {
            display: flex;
        }

        .bottom-nav-item {
            padding: 0.4rem 0.75rem;
            font-size: 0.65rem;
        }
    }
</style>

---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-brand">
                <div class="logo-group">
                    <img src="/logo.png" alt="fullai.dev" class="logo-img-small">
                    <span class="logo-text-small">fullai<span class="dot">.</span>dev</span>
                </div>
                <p class="footer-tagline" data-en="Intelligent Systems" data-es="Sistemas Inteligentes">Intelligent Systems</p>
            </div>
            <div class="footer-links">
                <div class="footer-column">
                    <h4 data-en="Services" data-es="Servicios">Services</h4>
                    <a href="/#services" data-en="AI Strategy" data-es="Estrategia IA">AI Strategy</a>
                    <a href="/#services" data-en="Development" data-es="Desarrollo">Development</a>
                    <a href="/#services" data-en="Integration" data-es="Integración">Integration</a>
                </div>
                <div class="footer-column">
                    <h4 data-en="Company" data-es="Empresa">Company</h4>
                    <a href="/#approach" data-en="Approach" data-es="Enfoque">Approach</a>
                    <a href="/#contact" data-en="Contact" data-es="Contacto">Contact</a>
                    <a href="mailto:hello@fullai.dev" data-en="Careers" data-es="Carreras">Careers</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p data-en={`© ${currentYear} fullai.dev. Building intelligent systems.`} data-es={`© ${currentYear} fullai.dev. Construyendo sistemas inteligentes.`}>© {currentYear} fullai.dev. Building intelligent systems.</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: var(--color-bg);
        border-top: 1px solid var(--color-border);
        padding: 4rem 0 2rem;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .footer-content {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 4rem;
        margin-bottom: 3rem;
    }

    .logo-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logo-img-small {
        width: 32px;
        height: 32px;
        border-radius: 50%;
    }

    .logo-text-small {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
    }

    .dot {
        color: var(--color-primary);
    }

    .footer-tagline {
        color: var(--color-text-dim);
        margin-top: 1rem;
        font-size: 0.95rem;
    }

    .footer-links {
        display: flex;
        gap: 4rem;
    }

    .footer-column h4 {
        font-family: var(--font-display);
        font-size: 1rem;
        margin-bottom: 1rem;
        color: var(--color-text);
    }

    .footer-column a {
        display: block;
        color: var(--color-text-dim);
        text-decoration: none;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
        transition: color 0.3s var(--ease-smooth);
    }

    .footer-column a:hover {
        color: var(--color-primary);
    }

    .footer-bottom {
        text-align: center;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-dim);
        font-size: 0.9rem;
    }

    @media (max-width: 968px) {
        .footer-content {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    @media (max-width: 640px) {
        .footer {
            padding: 3rem 0 6rem;
        }

        .footer-content {
            text-align: center;
        }

        .logo-group {
            justify-content: center;
        }

        .footer-tagline {
            font-size: 0.85rem;
        }

        .footer-links {
            justify-content: center;
            gap: 3rem;
        }

        .footer-column h4 {
            font-size: 0.9rem;
        }

        .footer-column a {
            font-size: 0.85rem;
        }

        .footer-bottom {
            font-size: 0.8rem;
        }
    }
</style>

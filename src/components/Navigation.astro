---
interface Props {
    currentPage?: string;
}

const { currentPage = 'home' } = Astro.props;
---

<!-- Skip Link for Accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Navigation -->
<nav class="nav" role="navigation" aria-label="Main navigation">
    <div class="nav-container">
        <a href="/" class="logo" aria-label="fullai.dev Home">
            <div class="logo-group">
                <img src="/logo.png" alt="fullai.dev" class="logo-img">
                <span class="logo-text">fullai<span class="dot">.</span>dev</span>
            </div>
        </a>
        <div class="nav-links">
            <a href="/#services" data-en="Services" data-es="Servicios">Services</a>
            <a href="/#approach" data-en="Approach" data-es="Enfoque">Approach</a>
            <a href="/blog" class:list={[{ active: currentPage === 'blog' }]} data-en="Blog" data-es="Blog">Blog</a>
            <a href="/#contact" class="nav-cta" data-en="Let's Talk" data-es="Hablemos">Let's Talk</a>
            <button class="lang-switch" id="langSwitch" aria-label="Switch language">
                <span class="flag" id="currentFlag">🇺🇸</span>
                <span class="lang-code" id="currentLang">EN</span>
            </button>
        </div>
    </div>
</nav>

<style>
    /* Skip Link for Accessibility */
    .skip-link {
        position: absolute;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--color-primary);
        color: var(--color-bg);
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        z-index: 9999;
        transition: top 0.3s var(--ease-smooth);
    }

    .skip-link:focus {
        top: 1rem;
        outline: 3px solid var(--color-accent);
        outline-offset: 2px;
    }

    /* Navigation */
    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(10, 14, 23, 0.8);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        animation: slideDown 0.6s var(--ease-smooth);
    }

    @keyframes slideDown {
        from {
            transform: translateY(-100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .nav-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1.25rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        text-decoration: none;
    }

    .logo-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logo-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }

    .logo-text {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text);
    }

    .dot {
        color: var(--color-primary);
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .nav-links a {
        color: var(--color-text-dim);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 400;
        transition: all 0.4s var(--ease-smooth);
        position: relative;
        padding: 0.5rem 0;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--color-primary);
        text-shadow: 0 0 15px rgba(0, 255, 163, 0.4);
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
        transition: all 0.4s var(--ease-smooth);
        transform: translateX(-50%);
        border-radius: 2px;
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
        width: 100%;
    }

    .nav-links a.nav-cta {
        background: var(--color-primary);
        color: var(--color-bg) !important;
        padding: 0.5rem 1.75rem !important;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.4s var(--ease-smooth);
    }

    .nav-cta::after {
        display: none;
    }

    .nav-cta:hover {
        background: var(--color-primary);
        transform: translateY(-3px);
        box-shadow: 0 5px 25px rgba(0, 255, 163, 0.4);
    }

    /* Language Switch */
    .lang-switch {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: transparent;
        border: 1px solid var(--color-border);
        padding: 0.5rem 0.85rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.4s var(--ease-smooth);
        position: relative;
        overflow: hidden;
        font-family: var(--font-mono);
    }

    .lang-switch::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(0, 255, 163, 0.1), rgba(0, 212, 255, 0.1));
        opacity: 0;
        transition: opacity 0.4s var(--ease-smooth);
    }

    .lang-switch:hover::before {
        opacity: 1;
    }

    .lang-switch:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
    }

    .lang-switch .flag {
        font-size: 1rem;
        position: relative;
        z-index: 1;
        transition: transform 0.3s var(--ease-bounce);
    }

    .lang-switch:hover .flag {
        transform: scale(1.1);
    }

    .lang-switch .lang-code {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-text-dim);
        position: relative;
        z-index: 1;
        transition: color 0.3s var(--ease-smooth);
    }

    .lang-switch:hover .lang-code {
        color: var(--color-primary);
    }

    /* Mobile */
    @media (max-width: 968px) {
        .nav-links a:not(.nav-cta):not(.lang-switch) {
            display: none;
        }

        .nav-links .nav-cta {
            padding: 0.4rem 1rem !important;
            font-size: 0.85rem;
        }

        .nav-container {
            padding: 1rem;
        }

        .logo-img {
            width: 32px;
            height: 32px;
        }

        .logo-text {
            font-size: 1.25rem;
        }
    }
</style>
